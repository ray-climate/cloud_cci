digraph pipeline {
    rankdir=LR;
    fontname="Helvetica";
    nodesep=0.35;
    ranksep=0.6;
    splines=spline;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    subgraph cluster_ec {
        label=<<b>EarthCARE L2 (via ESA MAAP)</b>>;
        labelloc="t";
        style="rounded,dashed";
        color="#2e7d32";
        bgcolor="#f4faf4";
        fontname="Helvetica";
        fontsize=11;
        ECA [label=<<b>ATLID-only</b><br/>(driver track)>, fillcolor="#e8f5e9", color="#2e7d32"];
        ECS [label=<Synergy nadir<br/>(secondary)>, fillcolor="#e8f5e9", color="#2e7d32"];
    }

    subgraph cluster_sev {
        label=<<b>SEVIRI ORAC L2 (15-min slots)</b>>;
        labelloc="t";
        style="rounded,dashed";
        color="#2e7d32";
        bgcolor="#f4faf4";
        fontname="Helvetica";
        fontsize=11;
        SEVF [label=<3712 × 3712 disk<br/>cot · cer · cth · ...<br/>land/sea mask>, fillcolor="#e8f5e9", color="#2e7d32"];
    }

    TM  [label=<<b>Time match</b><br/>nearest SEVIRI slot<br/>|Δt| ≤ 7.5 min>,                           fillcolor="#e3f2fd", color="#1565c0"];
    SM  [label=<<b>Space match</b><br/>on-disk filter +<br/>nearest pixel (haversine)<br/>distance recorded>, fillcolor="#e3f2fd", color="#1565c0"];
    NJ  [label=<<b>Nadir join</b><br/>by along_track index<br/>(synergy on ATLID grid)>,                fillcolor="#e3f2fd", color="#1565c0"];
    REF [label=<<b>Reference mapper</b><br/>extract ORAC-equivalent<br/>per ATLID profile>,             fillcolor="#e3f2fd", color="#1565c0"];

    DB  [label=<<b>matches CSV</b><br/>1 row per ATLID profile<br/>+ sev_pixel_id · n_atlid ·<br/>distance_km · time_diff_s>,
         shape=cylinder, fillcolor="#fff3cd", color="#b8860b"];

    AGG [label=<<b>Aggregate</b> by sev_pixel_id<br/>per-variable rule>, fillcolor="#e3f2fd", color="#1565c0"];
    STR [label=<<b>Stratify</b><br/>τ · phase · lat band ·<br/>day-night · land cover>, fillcolor="#e3f2fd", color="#1565c0"];
    ST  [label=<<b>Stats</b><br/>continuous: bias · RMSE · R · slope>, fillcolor="#e3f2fd", color="#1565c0"];

    NC  [label=<<b>stats.nc</b><br/>monthly summary>, shape=cylinder, fillcolor="#fce4ec", color="#ad1457"];
    FIG [label=<<b>Figures</b><br/>scatter · diff map ·<br/>histogram>, fillcolor="#fce4ec", color="#ad1457"];

    ECA -> TM;
    SEVF -> TM;
    TM -> SM;
    ECA -> SM;
    SEVF -> SM;
    SM -> REF;
    ECS -> NJ;
    ECA -> NJ;
    NJ -> REF;
    REF -> DB;
    DB -> AGG;
    AGG -> STR;
    STR -> ST;
    ST -> NC;
    ST -> FIG;
}
